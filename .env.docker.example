# =============================================================================
# ENVIRONMENT CONFIGURATION FOR DOCKER COMPOSE (foodai)
# Copy this file to .env and modify it before running: docker compose up -d
# =============================================================================

# 1. DATABASE CONFIGURATION (used inside docker network)
DB_ROOT_PASSWORD=root_secure_password_here
DB_NAME=foodai
DB_USER=foodai
DB_PASSWORD=foodai_secure_password_here

# 2. SITE/DOMAIN CONFIGURATION (For CORS and API redirections)
# Replace with your production domain name, e.g., https://yourdomain.com
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# 3. JWT AUTHENTICATION SECRETS (Change these to long, random string hashes)
JWT_SECRET=super_secret_jwt_sign_key_for_authentication_tokens_change_me
JWT_REFRESH_SECRET=super_secret_jwt_refresh_sign_key_change_me

# 4. EMAIL CONFIGURATION (Gmail OAuth2 setup for OTP retrieval)
EMAIL_USER=dien_email_gmail_cua_ban@gmail.com
EMAIL_CLIENT_ID=client_id
EMAIL_CLIENT_SECRET=client_secret
EMAIL_REFRESH_TOKEN=EMAIL_REFRESH_TOKENlol

# 5. PAYMENT GATEWAY CONFIGURATION (SePay integration details)
SEPAY_WEBHOOK_TOKEN=your_secure_sepay_webhook_token
SEPAY_ACCOUNT_NO=0964645267
SEPAY_BANK=MB

# 6. LLM AI CHATBOT (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# 7. FRONTEND APP CONFIGURATION (Used during React Vite compilation)
VITE_APP_NAME=m4nFood
